# Copy this file to .env.local for local development.
# In Vercel, set the same keys under Project Settings → Environment Variables.

# --- Access control -----------------------------------------------------
# The single password that unlocks the app. Anyone with this password (and
# a device that can reach the deployed URL) can read/write everything, so
# pick something you wouldn't mind sharing with nobody.
APP_PASSWORD=

# Signs the login session cookie. Generate with: openssl rand -hex 32
# Keep this stable — rotating it logs everyone out.
SESSION_SECRET=

# --- Storage (Supabase) --------------------------------------------------
# Project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=

# Service role key (Project Settings → API → service_role). This key
# bypasses RLS and must NEVER be exposed to the browser — it is only read
# in server-side API routes (app/api/*/route.ts), never in a client
# component or NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# Run supabase/schema.sql once against your project (SQL Editor, or the
# Supabase CLI) before first use — it creates the tracker_state and
# parse_log tables. The same two variables are read by
# `npm run export-training-data` (scripts/export-training-data.ts) outside
# of Next.js, for pulling parse_log into train/eval JSONL.

# --- AI quick-add fallback -------------------------------------------------
# Optional. The local rules engine (lib/parse/) handles quick-add first, at
# zero cost; this key only gets used, server-side, when its confidence is
# below threshold (see app/api/quick-add/route.ts). Leave unset and the app
# still works end to end — low-confidence notes just stay low-confidence
# for the correction UI to catch.
ANTHROPIC_API_KEY=
