# Optional: Custom Self-Hosted Playwright WS cluster endpoint
# PLAYWRIGHT_WS_ENDPOINT=ws://your-playwright-cluster:3000

# Recommended for reliable Google Business Profile discovery. Enable the
# Places API (New) for this key and restrict it to the Places API + this
# server's IP address. Never expose this server-side key in browser code.
# GOOGLE_MAPS_API_KEY=your_server_side_key

# Optional keys for additional Google/Bing SERP discovery coverage.
# GOOGLE_CSE_KEY=your_google_custom_search_key
# GOOGLE_CSE_ID=your_google_custom_search_engine_id
# BING_SEARCH_KEY=your_bing_search_key

# Free OpenStreetMap discovery is enabled by default. Keep it for occasional,
# user-triggered searches only; use your own OSM service for high-volume usage.
# ENABLE_OSM_DISCOVERY=true
# OSM_USER_AGENT=NexusSuiteCitationAudit/1.0 (contact: you@example.com)

# Supabase Cloud Database Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# GBP OAuth and server-side AES-256-GCM token encryption.
# INTERNAL_OPERATOR_NAME=AgastyaOne Internal Operator
# TOKEN_ENCRYPTION_KEY=64_hex_characters_for_a_32_byte_key
# GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain/api/gbp/oauth/callback

# Worker Settings
POLL_INTERVAL_MS=5000
HEADLESS=true

# Required for every deployed instance: gates the dashboard and all /api/*
# routes behind a login page. Approved corrections push real writes to a
# client's live Google Business Profile, so this should never be left unset
# outside of local development.
# INTERNAL_APP_PASSWORD=choose_a_strong_operator_password
# Signs session cookies. If unset, a random secret is generated per process
# (every restart/deploy signs everyone out). Set a stable 32+ byte value in
# production, e.g. `openssl rand -hex 32`.
# SESSION_SECRET=64_hex_characters
